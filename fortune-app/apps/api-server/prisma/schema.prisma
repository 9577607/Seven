generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model users {
  id         BigInt   @id @default(autoincrement())
  open_id    String   @unique @db.VarChar(64)
  union_id   String?  @db.VarChar(64)
  nickname   String   @db.VarChar(64)
  avatar_url String   @db.VarChar(255)
  gender     Int?
  birthday   DateTime?
  birth_hour String?  @db.VarChar(16)
  birth_city String?  @db.VarChar(64)
  phone      String?  @db.VarChar(32)
  status     Int      @default(1)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model admin_users {
  id            BigInt   @id @default(autoincrement())
  username      String   @unique @db.VarChar(64)
  password_hash String   @db.VarChar(255)
  nickname      String   @db.VarChar(64)
  status        Int      @default(1)
  last_login_at DateTime?
  created_at    DateTime @default(now())
}

model roles { id BigInt @id @default(autoincrement()) name String @db.VarChar(64) code String @unique @db.VarChar(64) description String? @db.VarChar(255) }
model permissions { id BigInt @id @default(autoincrement()) name String @db.VarChar(64) code String @unique @db.VarChar(128) type String @db.VarChar(32) path String? @db.VarChar(255) }
model admin_user_roles { admin_user_id BigInt role_id BigInt @@id([admin_user_id, role_id]) }
model role_permissions { role_id BigInt permission_id BigInt @@id([role_id, permission_id]) }
model banners { id BigInt @id @default(autoincrement()) title String @db.VarChar(128) image_url String @db.VarChar(255) jump_type String @db.VarChar(32) jump_value String @db.VarChar(255) sort_order Int @default(0) status Int @default(1) start_at DateTime? end_at DateTime? created_at DateTime @default(now()) }
model notices { id BigInt @id @default(autoincrement()) title String @db.VarChar(255) summary String? @db.VarChar(255) content String @db.Text status Int @default(1) published_at DateTime? created_at DateTime @default(now()) }
model system_configs { id BigInt @id @default(autoincrement()) config_group String @db.VarChar(64) config_key String @unique @db.VarChar(128) config_value Json description String? @db.VarChar(255) updated_at DateTime @updatedAt }
model sensitive_words { id BigInt @id @default(autoincrement()) word String @unique @db.VarChar(128) level Int @default(1) status Int @default(1) }
model report_templates { id BigInt @id @default(autoincrement()) template_type String @db.VarChar(32) name String @db.VarChar(128) version Int @default(1) content Json status Int @default(0) published_at DateTime? created_by BigInt created_at DateTime @default(now()) }
model tarot_cards { id BigInt @id @default(autoincrement()) card_no Int name String @db.VarChar(128) image_url String @db.VarChar(255) upright_keywords Json reversed_keywords Json upright_desc String @db.Text reversed_desc String @db.Text status Int @default(1) sort_order Int @default(0) }
model reports { id BigInt @id @default(autoincrement()) user_id BigInt report_type String @db.VarChar(32) title String @db.VarChar(255) input_snapshot Json result_snapshot Json score Int? share_token String? @db.VarChar(64) is_favorite Int @default(0) created_at DateTime @default(now()) }
model report_tags { id BigInt @id @default(autoincrement()) report_id BigInt tag_name String @db.VarChar(64) }
model user_favorites { id BigInt @id @default(autoincrement()) user_id BigInt report_id BigInt created_at DateTime @default(now()) }
model share_logs { id BigInt @id @default(autoincrement()) user_id BigInt report_id BigInt share_channel String @db.VarChar(32) created_at DateTime @default(now()) }
model event_logs { id BigInt @id @default(autoincrement()) user_id BigInt? event_name String @db.VarChar(128) event_data Json created_at DateTime @default(now()) }
model feedbacks { id BigInt @id @default(autoincrement()) user_id BigInt category String @db.VarChar(64) content String @db.Text images Json contact String? @db.VarChar(128) status String @db.VarChar(32) handler_id BigInt? handler_note String? @db.Text created_at DateTime @default(now()) updated_at DateTime @updatedAt }
model admin_operation_logs { id BigInt @id @default(autoincrement()) admin_user_id BigInt module String @db.VarChar(64) action String @db.VarChar(64) target_id String @db.VarChar(64) detail Json ip String @db.VarChar(64) created_at DateTime @default(now()) }
