# Common
NODE_ENV=development
PORT=3000
JWT_SECRET=change_me_to_a_long_random_value
DATABASE_URL=postgres://postgres:postgres@postgres:5432/autocontent
REDIS_URL=redis://redis:6379
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
WORKFLOW_QUEUE=autocontent_tasks
AI_SERVICE_URL=http://ai_service:8000
AI_TIMEOUT_MS=15000

# Security
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
API_RATE_LIMIT=180
AUTH_RATE_LIMIT=30
DB_SSL=false

# Nginx HTTPS cert path (prod)
SSL_CERT_PATH=/etc/nginx/certs/fullchain.pem
SSL_KEY_PATH=/etc/nginx/certs/privkey.pem
