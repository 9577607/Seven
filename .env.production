NODE_ENV=production
PORT=3000
JWT_SECRET=replace_with_production_secret
DATABASE_URL=postgres://postgres:postgres@postgres:5432/autocontent
REDIS_URL=redis://redis:6379
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
WORKFLOW_QUEUE=autocontent_tasks
AI_SERVICE_URL=http://ai_service:8000
AI_TIMEOUT_MS=15000
CORS_ORIGINS=https://your-domain.com
API_RATE_LIMIT=240
AUTH_RATE_LIMIT=40
DB_SSL=false
SSL_CERT_PATH=/etc/nginx/certs/fullchain.pem
SSL_KEY_PATH=/etc/nginx/certs/privkey.pem
